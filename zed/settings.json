// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "auto_install_extensions": {
    "biome": true,
    "dockerfile": true,
    "docker-compose": true,
    "kotlin": true,
    "scss": true,
    "swift": true,
    "terraform": true,
    "tsgo": true,
    "oxc": true
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/build",
    "**/ios/vendor",
    "**/android/vendor",
    "**/node_modules"
  ],
  "languages": {
    "JavaScript": {
      "language_servers": ["!vtsls"],
      "format_on_save": "on",
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TypeScript": {
      "language_servers": ["tsgo", "!vtsls"],
      "format_on_save": "on",
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TSX": {
      "language_servers": ["tsgo", "!vtsls"],
      "format_on_save": "on",
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" }
      ]
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.eslint" }
      ]
    }
  },
  "lsp": {
    "tsgo": {
      "binary": {
        "path": "bash",
        "arguments": ["./src/cli/tsgo", "--lsp", "--stdio"]
      },
      "settings": {
        "autoUseWorkspaceTsdk": true,
        "experimental": {
          "completion": {
            "enableServerSideFuzzyMatch": true
          }
        },
        "typescript": {
          "tsdk": "node_modules/typescript/lib",
          "tsserver": {
            "maxTsServerMemory": 24276,
            "nodePath": "./src/cli/tsserverNode"
          }
        }
      }
    },
    "oxlint": {
      "binary": {
        "path": "bash",
        "arguments": ["./src/tools-lint/cli/oxlint-lsp-proxy"]
      }
    },
    "vtsls": {
      "settings": {
        "autoUseWorkspaceTsdk": true,
        "experimental": {
          "completion": {
            "enableServerSideFuzzyMatch": true
          }
        },
        "typescript": {
          "tsdk": "node_modules/typescript/lib",
          "tsserver": {
            "maxTsServerMemory": 24276,
            "nodePath": "./src/cli/tsserverNode"
          }
        }
      }
    }
  },

  "soft_wrap": "editor_width",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "proxy": "",
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },

  "scroll_beyond_last_line": "off",
}
